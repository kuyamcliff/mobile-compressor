# Pinned third-party versions for the native media engine.
# Every entry is built from source by build_deps.sh. Update a version here and
# re-run the script to upgrade a component independently of the app code.

FFMPEG_VERSION=9.0.2
FFMPEG_URL=https://ffmpeg.org/releases/ffmpeg-${FFMPEG_VERSION}.tar.xz

